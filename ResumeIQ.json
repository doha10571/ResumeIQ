        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{\n{\n  \"contents\": [\n    {\n      \"parts\": [\n        {\n          \"text\": \"You are a job description parsing assistant. Read the job description and return ONLY a valid JSON object with these keys:\\n\\nrequired_skills: array of strings\\nnice_to_have_skills: array of strings\\nmin_years_experience: number\\nresponsibilities: array of strings\\n\\nDo not add markdown or explanations.\\nDo not invent information.\\nIf information is missing, use an empty array or 0.\\n\\nJOB DESCRIPTION:\\n\" + $json.job_description\n        }\n      ]\n    }\n  ],\n  \"generationConfig\": {\n    \"temperature\": 0,\n    \"responseMimeType\": \"application/json\"\n  }\n}\n}}",
        "options": {}
      },
