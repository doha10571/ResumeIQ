    {
      "parameters": {
        "jsCode": "const cvRow = $(\"Get CV\").first().json;\nconst analysisRow = $(\"Get Analysis\").first().json;\nconst requestBody = $(\"CV Tailoring Webhook\").first().json.body || {};\n\nconst analysisData = analysisRow.analysis_data || {};\n\nconst matchResult = analysisData.match_result || {\n  match_score: analysisRow.match_score,\n  matched_skills: analysisRow.matched_skills || [],\n  missing_skills: analysisRow.missing_skills || [],\n  recommendations: analysisRow.recommendations || []\n};\n\n// The user may untick some recommendations on the analysis screen.\nif (Array.isArray(requestBody.recommendations)) {\n  matchResult.recommendations = requestBody.recommendations;\n}\n\nreturn [\n  {\n    json: {\n      cv_id: cvRow.cv_id || cvRow.id,\n      cv_text: cvRow.cv_text,\n      job_id: analysisRow.job_id,\n      cv_analysis: analysisData.cv_analysis || {},\n      job_analysis: analysisData.job_analysis || {},\n      match_result: matchResult\n    }\n  }\n];"
      },
      "id": "82fcaf53-c089-438b-9064-62b3ee7336d3",
      "name": "Combine CV and Analysis",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        576
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-3.5-flash-lite:generateContent",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{\n{\n  \"contents\": [\n    {\n      \"parts\": [\n        {\n          \"text\": \"You are a professional CV tailoring system.\\n\\nYour task is to tailor the candidate's CV for the target job description.\\n\\nSTRICT RULES:\\n1. Never invent experience, skills, education, certifications, employers, job titles, projects, achievements, or responsibilities.\\n2. Only use information that already exists in the original CV.\\n3. Do not add a skill just because it appears in the job description.\\n4. You may improve wording, structure, clarity, and keyword relevance when supported by the original CV.\\n5. Prioritize relevant experience and skills for the target job.\\n6. Preserve factual accuracy.\\n7. Do not change dates, companies, degrees, or job titles.\\n8. Do not remove important factual information unless it is clearly irrelevant.\\n9. Optimize the CV for ATS systems.\\n10. Use professional English.\\n11. Copy the candidate full name and contact details (email, phone, location, links) exactly as they appear in the original CV. Use empty values if they are missing.\\n\\nReturn ONLY valid JSON with exactly these keys:\\n{\\n  \\\"full_name\\\": \\\"\\\",\\n  \\\"contact\\\": {\\\"email\\\": \\\"\\\", \\\"phone\\\": \\\"\\\", \\\"location\\\": \\\"\\\", \\\"links\\\": []},\\n  \\\"professional_summary\\\": \\\"\\\",\\n  \\\"skills\\\": [],\\n  \\\"experience\\\": [],\\n  \\\"education\\\": [],\\n  \\\"additional_sections\\\": [],\\n  \\\"changes_made\\\": [],\\n  \\\"warnings\\\": []\\n}\\n\\nORIGINAL CV:\\n\" + $json.cv_text + \"\\n\\nCV ANALYSIS:\\n\" + JSON.stringify($json.cv_analysis) + \"\\n\\nJOB ANALYSIS:\\n\" + JSON.stringify($json.job_analysis) + \"\\n\\nMATCH RESULT:\\n\" + JSON.stringify($json.match_result)\n        }\n      ]\n    }\n  ],\n  \"generationConfig\": {\n    \"temperature\": 0,\n    \"responseMimeType\": \"application/json\"\n  }\n}\n}}",
        "options": {}
      },
      "id": "ef9ddceb-4e41-4785-897c-189c4252d35d",
      "name": "Tailor",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        448,
        592
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "1iOKoAc2QOgZopGv",
          "name": "Header Auth account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const aiResponse = $input.first().json;\n\nconst rawText = aiResponse.candidates[0].content.parts[0].text;\n\nconst tailoredCv = JSON.parse(rawText);\n\nconst previousData = $(\"Combine CV and Analysis\").first().json;\n\nreturn [\n  {\n    json: {\n      cv_id: previousData.cv_id,\n      job_id: previousData.job_id,\n      tailored_cv: tailoredCv\n    }\n  }\n];"
      },
      "id": "ec48fa57-ef62-4777-b255-b4135c7fecac",
      "name": "Parse Tailored CV",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        592
      ]
    },
    {
      "parameters": {
        "jsCode": "// Check the tailored CV has the required fields.\nconst tailoredCv = $json.tailored_cv;\n\nconst requiredFields = [\n  \"professional_summary\",\n  \"skills\",\n  \"experience\",\n  \"education\"\n];\n\nconst missingFields = [];\n\nfor (let i = 0; i < requiredFields.length; i++) {\n  const fieldName = requiredFields[i];\n  const fieldValue = tailoredCv[fieldName];\n\n  let isMissing = false;\n\n  if (fieldValue === undefined || fieldValue === null) {\n    isMissing = true;\n  } \n  else if (Array.isArray(fieldValue) && fieldValue.length === 0) {\n    isMissing = true;\n  } \n  else if (typeof fieldValue === \"string\" && fieldValue.trim().length === 0) {\n    isMissing = true;\n  }\n\n  if (isMissing) {\n    missingFields.push(fieldName);\n  }\n}\n\nconst isValid = missingFields.length === 0;\n\nreturn [\n  {\n    json: {\n      cv_id: $json.cv_id,\n      job_id: $json.job_id,\n      tailored_cv: tailoredCv,\n      is_valid: isValid,\n      missing_fields: missingFields\n    }\n  }\n];"
      },
