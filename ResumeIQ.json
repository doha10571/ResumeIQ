    {
      "parameters": {
        "jsCode": "const aiResponse = $input.first().json;\n\nconst rawText = aiResponse.candidates[0].content.parts[0].text;\n\nconst matchResult = JSON.parse(rawText);\n\nconst previousData = $(\"Parse Job Analysis\").first().json;\n\nreturn [\n  {\n    json: {\n      cv_id: previousData.cv_id,\n      job_id: previousData.job_id,\n      cv_analysis: previousData.cv_analysis,\n      job_analysis: previousData.job_analysis,\n      match_result: matchResult\n    }\n  }\n];"
      },
