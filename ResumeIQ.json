      "parameters": {
        "jsCode": "// Get Gemini response\nconst aiResponse = $input.first().json;\n\n// Get the generated JSON text from Gemini\nconst rawText = aiResponse.candidates[0].content.parts[0].text;\n\n// Convert the JSON string into a real JSON object\nconst jobAnalysis = JSON.parse(rawText);\n\n// Return structured job analysis\nreturn [\n  {\n    json: {\n      cv_id: $(\"Parse CV Analysis\").first().json.cv_id,\n      job_id: $(\"Parse CV Analysis\").first().json.job_id,\n      job_description: $(\"Parse CV Analysis\").first().json.job_description,\n\n      cv_analysis: $(\"Parse CV Analysis\").first().json.cv_analysis,\n\n      job_analysis: jobAnalysis\n    }\n  }\n];"
