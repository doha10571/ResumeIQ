    {
      "parameters": {
        "jsCode": "const data = $input.first().json;\nconst cv = data.tailored_cv;\n\nfunction escapeHtml(value) {\n  if (value === null || value === undefined) return \"\";\n  return String(value)\n    .replace(/&/g, \"&amp;\")\n    .replace(/</g, \"&lt;\")\n    .replace(/>/g, \"&gt;\")\n    .replace(/\"/g, \"&quot;\")\n    .replace(/'/g, \"&#039;\");\n}\n\nfunction asList(value) {\n  if (Array.isArray(value)) return value;\n  if (typeof value === \"string\" && value.trim().length > 0) return [value];\n  return [];\n}\n\nconst skills = asList(cv.skills)\n  .map(skill => `<li>${escapeHtml(skill)}</li>`)\n  .join(\"\");\n\nconst experience = asList(cv.experience)\n  .map(exp => {\n    if (typeof exp === \"string\") {\n      return `<li>${escapeHtml(exp)}</li>`;\n    }\n    // The AI sometimes returns \"responsibilities\", sometimes \"description\".\n    const bullets = asList(exp.responsibilities || exp.achievements || exp.description);\n    return `\n      <div class=\"experience-item\">\n        <h3>${escapeHtml(exp.job_title || exp.title || \"\")}</h3>\n        <p>${escapeHtml(exp.company || \"\")} ${escapeHtml(exp.years || exp.dates || \"\")}</p>\n        <ul>${bullets.map(r => `<li>${escapeHtml(r)}</li>`).join(\"\")}</ul>\n      </div>`;\n  })\n  .join(\"\");\n\nconst education = asList(cv.education)\n  .map(edu => {\n    if (typeof edu === \"string\") {\n      return `<li>${escapeHtml(edu)}</li>`;\n    }\n    return `\n      <div>\n        <strong>${escapeHtml(edu.degree || \"\")}</strong>\n        <span>${escapeHtml(edu.institution || edu.school || \"\")}</span>\n        <span>${escapeHtml(edu.year || \"\")}</span>\n      </div>`;\n  })\n  .join(\"\");\n\nconst html = `<!DOCTYPE html>\n<html><head><meta charset=\"UTF-8\"><title>Tailored CV</title>\n<style>\nbody { font-family: Arial, sans-serif; max-width: 850px; margin: 40px auto; padding: 40px; color: #222; line-height: 1.6; }\nh1, h2, h3 { margin-bottom: 8px; }\nh2 { border-bottom: 1px solid #ccc; padding-bottom: 5px; margin-top: 25px; }\nul { padding-left: 20px; }\n.experience-item { margin-bottom: 20px; }\n.experience-item p { margin: 0 0 5px; font-weight: bold; }\n.experience-item h3 { margin-bottom: 2px; }\n</style></head>\n<body>\n<h1>Professional Summary</h1>\n<p>${escapeHtml(cv.professional_summary || \"\")}</p>\n<h2>Skills</h2><ul>${skills}</ul>\n<h2>Experience</h2>${experience}\n<h2>Education</h2>${education}\n</body></html>`;\n\nreturn [\n  {\n    json: {\n      cv_id: data.cv_id,\n      job_id: data.job_id,\n      tailored_cv: cv,\n      cv_html: html\n    }\n  }\n];"
      },
