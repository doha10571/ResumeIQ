          "name": "Header Auth account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const aiResponse = $input.first().json;\nconst rawText = aiResponse.candidates[0].content.parts[0].text;\nconst email = JSON.parse(rawText);\n\nconst webhookData = $(\"Application Webhook\").first().json.body;\nconst tailoredRow = $(\"Get Tailored CV\").first().json;\n\nif (!tailoredRow || !tailoredRow.id) {\n  throw new Error(\"Tailored CV not found for id \" + webhookData.tailored_cv_id);\n}\nif (!tailoredRow.resume_url) {\n  throw new Error(\"This tailored CV has no PDF yet (resume_url is empty). Run CV tailoring first.\");\n}\n\nreturn [\n  {\n    json: {\n      tailored_cv_id: tailoredRow.id,\n      // Take cv_id / job_id from the database row, not from the request.\n      cv_id: tailoredRow.cv_id,\n      job_id: tailoredRow.job_id,\n      recipient_email: webhookData.recipient_email,\n      subject: email.subject,\n      body: email.body,\n      resume_url: tailoredRow.resume_url\n    }\n  }\n];"
      },
