      "parameters": {
        "jsCode": "// Read the fields sent by the API / Backend.\nconst inputData = $input.first().json.body;\n\nconst cvId = inputData.cv_id;\nconst jobId = inputData.job_id;\nconst rawCvText = inputData.cv_text;\nconst jobDescription = inputData.job_description;\n\n// Clean the CV text line by line, using an explicit loop\n// so it is easy to follow and easy to change later.\nconst rawLines = rawCvText.split(\"\\n\");\nconst cleanedLines = [];\n\nfor (let i = 0; i < rawLines.length; i++) {\n  let currentLine = rawLines[i];\n  currentLine = currentLine.trim();\n\n  // Skip empty lines so the text sent to the AI is compact.\n  if (currentLine.length > 0) {\n    cleanedLines.push(currentLine);\n  }\n}\n\nconst cleanedCvText = cleanedLines.join(\"\\n\");\n\nreturn [\n  {\n    json: {\n      cv_id: cvId,\n      job_id: jobId,\n      cv_text: cleanedCvText,\n      job_description: jobDescription\n    }\n  }\n];"
      },
