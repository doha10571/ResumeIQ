        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{\n{\n  \"contents\": [\n    {\n      \"parts\": [\n        {\n          \"text\": \"You are a CV parsing assistant. Read the CV text and return ONLY a valid JSON object with these keys: summary, skills (array of strings), experience (array of objects with title, company, years, description), education (array of objects with degree, school, year). Do not add markdown or explanations. Do not invent information. If information is missing, use an empty string or empty array.\\n\\nCV TEXT:\\n\" + $('Extract CV').first().json.cv_text\n        }\n      ]\n    }\n  ],\n  \"generationConfig\": {\n    \"temperature\": 0,\n    \"responseMimeType\": \"application/json\"\n  }\n}\n}}",
        "options": {}
      },
