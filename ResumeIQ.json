      "parameters": {
        "jsCode": "const aiResponse = $input.first().json;\n\n// Get Gemini response text\nconst rawText = aiResponse.candidates[0].content.parts[0].text;\n\n// Convert JSON string into a real JSON object\nconst cvAnalysis = JSON.parse(rawText);\n\n// Return structured CV analysis\nreturn [\n  {\n    json: {\n      cv_id: $(\"Extract CV\").first().json.cv_id,\n      job_id: $(\"Extract CV\").first().json.job_id,\n      job_description: $(\"Extract CV\").first().json.job_description,\n      cv_analysis: cvAnalysis\n    }\n  }\n];"
      },
