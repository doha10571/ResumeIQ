            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{\n{\n  \"contents\": [\n    {\n      \"parts\": [\n        {\n          \"text\": \"You are a professional job application email writer.\\n\\nWrite a concise, professional application email for the candidate applying to a job.\\n\\nSTRICT RULES:\\n1. Do not invent any experience, skills, education, achievements, or qualifications.\\n2. Use only the information provided below.\\n3. The email must be professional and suitable for sending to HR or a recruiter.\\n4. Mention that the candidate is applying for the target position.\\n5. Mention that the CV is attached.\\n6. Keep the email concise.\\n7. Return ONLY valid JSON.\\n\\nReturn exactly this structure:\\n{\\n  \\\"subject\\\": \\\"\\\",\\n  \\\"body\\\": \\\"\\\"\\n}\\n\\nTAILORED CV:\\n\" + $json.tailored_cv_text + \"\\n\\nJOB DESCRIPTION:\\n\" + ($('Application Webhook').first().json.body.job_description || \"\")\n        }\n      ]\n    }\n  ],\n  \"generationConfig\": {\n    \"temperature\": 0,\n    \"responseMimeType\": \"application/json\"\n  }\n}\n}}",
        "options": {}
      },
      "id": "3575ea3f-7b14-4f08-bc1f-9dcd23a5d295",
      "name": "Generate Email",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -368,
        960
      ],
      "credentials": {
        "httpHeaderAuth": {
