    {
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-3.5-flash-lite:generateContent",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{\n{\n  \"contents\": [\n    {\n      \"parts\": [\n        {\n          \"text\": \"You are a professional ATS CV matching system.\\n\\nCompare the candidate CV analysis with the job analysis.\\n\\nImportant rules:\\n- Evaluate semantic meaning, not exact word matching.\\n- Only mark a requirement as matched when there is evidence in the CV.\\n- Do not assume a skill just because it is related to another skill.\\n- Consider skills, experience, education, responsibilities, and years of experience.\\n- Give a match score from 0 to 100.\\n- Provide practical recommendations for improving the CV.\\n- Do not invent experience or qualifications.\\n\\nReturn ONLY valid JSON with exactly these keys:\\n{\\n  \\\"match_score\\\": number,\\n  \\\"matched_skills\\\": [],\\n  \\\"missing_skills\\\": [],\\n  \\\"recommendations\\\": []\\n}\\n\\nCV ANALYSIS:\\n\" + JSON.stringify($json.cv_analysis) + \"\\n\\nJOB ANALYSIS:\\n\" + JSON.stringify($json.job_analysis)\n        }\n      ]\n    }\n  ],\n  \"generationConfig\": {\n    \"temperature\": 0,\n    \"responseMimeType\": \"application/json\"\n  }\n}\n}}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
